scenarios:
- name: Test
  code: |-
    const mockData = {
      campaignId: 'xp8m11',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      waitForUpdate: 500,
      regionalSettings: [{
        regions: 'US-CA, ES',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted'
      }]
    };

    // injectScript won't really load in the sandbox — mock it to call onsuccess immediately
    mock('injectScript', function (url, onsuccess, onfailure, cacheId) {
      // sanity-check the URL the template tries to load
      assertThat(url).isStrictlyEqualTo('https://app.complydog.com/complydog.v2.js?v=2.0.0');
      onsuccess();
    });

    // Run the template
    runCode(mockData);

    // The tag should finish successfully
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('setDefaultConsentState').wasCalled();
    assertApi('setInWindow').wasCalled();


